# ─────────────────────────────────────────────
# CrashGuard AI — Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# All variables are optional. The system runs in
# dry-run mode when credentials are absent.
# ─────────────────────────────────────────────

# Demo mode (1 = deterministic demo, 0 = live random)
DEMO_MODE=1

# ── Twilio — phone call escalation ──────────
# Triggers on ESCALATE decisions only.
# Sign up: https://twilio.com (free trial with $15 credit)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+91xxxxxxxxxx

# ── Gmail SMTP — email alerts ───────────────
# Triggers on ESCALATE, SCALE, and RESTART decisions.
# Setup: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# ── Slack (optional) ────────────────────────
SLACK_WEBHOOK_URL=
