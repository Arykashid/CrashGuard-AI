# CrashGuard AI — Environment Variables
# Copy this file to .env and fill in your values

# Demo mode (1 = stable demo behavior, 0 = live random)
DEMO_MODE=1

# Twilio — phone call escalation for ESCALATE decisions
# Sign up free at twilio.com, get $15 trial credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+91xxxxxxxxxx

# Gmail SMTP — email alerts for SCALE and RESTART decisions
# Get App Password: Google Account → Security → 2-Step → App Passwords
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
ALERT_EMAIL=destination@gmail.com

# Slack webhook (optional)
SLACK_WEBHOOK_URL=
